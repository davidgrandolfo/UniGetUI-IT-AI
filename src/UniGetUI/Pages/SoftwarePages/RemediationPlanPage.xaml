<Page
    x:Class="UniGetUI.Interface.SoftwarePages.RemediationPlanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="Remediation Plan" />
            <TextBlock x:Name="SubtitleText" Opacity="0.7" Text="Loading remediation plan..." />
        </StackPanel>

        <ListView x:Name="ActionsList" Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="8">
                        <TextBlock FontWeight="SemiBold" Text="{Binding PackageName}" />
                        <TextBlock Opacity="0.8" Text="{Binding ActionType}" />
                        <TextBlock Opacity="0.8" Text="{Binding Reason}" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
